<!--
  Home SOC Lab - custom Wazuh rules.
  Deploy to /var/ossec/etc/rules/local_rules.xml on the Wazuh server, then:
    sudo /var/ossec/bin/wazuh-analysisd -t && sudo systemctl restart wazuh-manager
  Parent rule IDs are Wazuh's built-in Sysmon rules (61603 = Event 1 process create,
  61615 = Event 13 registry value set). Confirm them under Server management > Rules.
-->
<group name="local,sysmon,home_soc_lab,">

  <rule id="100100" level="10">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s-(e|en|enc|encodedcommand)\s</field>
    <description>PowerShell executed with an encoded command</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <!-- 92302 = built-in "Run key modified via reg.exe" (level 6); it wins over 61615's other
       children, so this rule also chains off it to escalate the alert to level 10. -->
  <rule id="100101" level="10">
    <if_sid>61615, 92302</if_sid>
    <!-- Wazuh stores Windows paths with escaped (doubled) backslashes, hence \\+ between segments -->
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\+Software\\+Microsoft\\+Windows\\+CurrentVersion\\+Run(Once)?\\+</field>
    <description>Registry Run key modified (possible persistence): $(win.eventdata.targetObject)</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
  </rule>

  <rule id="100102" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\certutil\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)urlcache</field>
    <description>Certutil used to download a file</description>
    <mitre>
      <id>T1105</id>
    </mitre>
  </rule>

  <!-- Tuning (docs/detections.md FP-01): PowerShell drops __PSScriptPolicyTest_*.ps1 in %TEMP% on
       every start, tripping built-in 92213 at level 15. Silence ONLY that exact file from the real
       System32 powershell.exe; any other script dropped in Temp still alerts. -->
  <rule id="100110" level="0">
    <if_sid>92213</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)^C:\\+Windows\\+(System32|SysWOW64)\\+WindowsPowerShell\\+v1\.0\\+powershell\.exe$</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)\\+AppData\\+Local\\+Temp\\+__PSScriptPolicyTest_[a-z0-9]+\.[a-z0-9]+\.ps1$</field>
    <description>Ignored: PowerShell execution-policy test file (benign, FP-01)</description>
  </rule>

  <!-- Tuning (docs/detections.md FP-02): built-in 61618 flags svchost whose parent isn't services.exe.
       services.exe starts before Sysmon, so its GUID is all zeros and parentImage is empty, which trips
       the rule. Downgrade (not silence) to level 5: stays searchable in the dashboard, off Discord.
       Only for the real System32 svchost running as SYSTEM with that unresolved-parent signature. -->
  <rule id="100111" level="5">
    <if_sid>61618</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)^C:\\+Windows\\+System32\\+svchost\.exe$</field>
    <field name="win.eventdata.parentProcessGuid" type="pcre2">^\{00000000-0000-0000-0000-000000000000\}$</field>
    <field name="win.eventdata.user" type="pcre2">(?i)^NT AUTHORITY\\+SYSTEM$</field>
    <description>svchost.exe with unresolved parent (services.exe started before Sysmon), downgraded (FP-02)</description>
    <mitre>
      <id>T1055</id>
    </mitre>
  </rule>

</group>
